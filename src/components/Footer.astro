---
import type { Contacto } from '@/lib/types';
import { getServiciosPorCategoria, rutaServicio } from '@/lib/wp';
import { withBase } from '@/lib/url';

interface Props { contacto: Contacto }
const { contacto } = Astro.props;
const consultorias = (await getServiciosPorCategoria('consultoria'));
const capacitaciones = (await getServiciosPorCategoria('capacitacion')).slice(0, 5);
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-navy-950 text-white/75">
  <div class="pointer-events-none absolute -top-40 right-0 h-96 w-96 rounded-full bg-brand-600/20 blur-3xl"></div>
  <div class="container-x relative grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <img src={withBase('/logo-blanco.svg')} alt="Vortec Consulting" width="220" height="69" class="h-16 w-auto" loading="lazy" />
      <p class="mt-5 max-w-sm text-sm leading-relaxed">
        Consultoría y capacitación técnica para laboratorios e industria: calidad, acreditación NCh-ISO/IEC 17025,
        instrumentación analítica, mejora continua y medio ambiente.
      </p>
      <div class="mt-6 flex gap-3">
        {contacto.linkedin && <a href={contacto.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 hover:border-brand-400 hover:text-brand-400"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 110-4.12 2.06 2.06 0 010 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a>}
        {contacto.instagram && <a href={contacto.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 hover:border-brand-400 hover:text-brand-400"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 100 12.32 6.16 6.16 0 000-12.32zM12 16a4 4 0 110-8 4 4 0 010 8zm6.4-11.85a1.44 1.44 0 100 2.88 1.44 1.44 0 000-2.88z"/></svg></a>}
        {contacto.facebook && <a href={contacto.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 hover:border-brand-400 hover:text-brand-400"><svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.49h-2.8V24C19.62 23.1 24 18.1 24 12.07z"/></svg></a>}
      </div>
    </div>

    <div class="lg:col-span-2">
      <h3 class="text-sm font-bold uppercase tracking-wider text-white">Consultorías</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {consultorias.map((s) => <li><a href={rutaServicio(s)} class="hover:text-brand-400">{s.titulo}</a></li>)}
      </ul>
    </div>

    <div class="lg:col-span-3">
      <h3 class="text-sm font-bold uppercase tracking-wider text-white">Capacitaciones</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {capacitaciones.map((s) => <li><a href={rutaServicio(s)} class="hover:text-brand-400">{s.titulo}</a></li>)}
        <li><a href={withBase('/capacitaciones')} class="font-semibold text-brand-400 hover:text-brand-300">Ver todas →</a></li>
      </ul>
    </div>

    <div class="lg:col-span-3">
      <h3 class="text-sm font-bold uppercase tracking-wider text-white">Contacto</h3>
      <ul class="mt-4 space-y-3 text-sm">
        <li><a href={`https://wa.me/${contacto.whatsapp}`} target="_blank" rel="noopener" class="hover:text-brand-400">{contacto.telefono}</a></li>
        <li><a href={`mailto:${contacto.email}`} class="hover:text-brand-400">{contacto.email}</a></li>
        <li>{contacto.direccion}<br />{contacto.comuna}, {contacto.ciudad}</li>
        <li class="text-white/50">{contacto.horario}</li>
        <li><a href={withBase('/noticias')} class="font-semibold text-brand-400 hover:text-brand-300">Noticias</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x flex flex-col items-center justify-between gap-2 py-5 text-xs text-white/45 sm:flex-row">
      <p>© {year} {contacto.empresa}. Todos los derechos reservados.</p>
      <p>Diseño web: <a href="https://diseñopaginas.cl" target="_blank" rel="noopener" class="hover:text-brand-400">diseñopaginas.cl</a></p>
    </div>
  </div>
</footer>
