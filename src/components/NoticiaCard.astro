---
import type { Noticia } from '@/lib/types';
import { rutaNoticia, fechaLarga } from '@/lib/wp';
import { withBase } from '@/lib/url';
interface Props { noticia: Noticia; delay?: number; destacada?: boolean }
const { noticia: n, delay = 0, destacada = false } = Astro.props;
---
{destacada ? (
  <a href={rutaNoticia(n)} class="card reveal group grid overflow-hidden lg:grid-cols-[1.15fr_1fr]">
    <div class="relative aspect-[16/10] overflow-hidden bg-navy-900 lg:aspect-auto lg:min-h-[360px]">
      <img src={withBase(n.imagen)} alt={n.titulo} loading="eager" decoding="async" width="1400" height="875" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]" />
      <span class="absolute left-4 top-4 rounded-full bg-brand-600/90 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-white">Destacada</span>
    </div>
    <div class="flex flex-col justify-center p-7 lg:p-10">
      <p class="text-xs font-bold uppercase tracking-wider text-muted">{fechaLarga(n.fecha)}</p>
      <h2 class="mt-3 text-2xl font-bold leading-snug group-hover:text-brand-600 lg:text-3xl">{n.titulo}</h2>
      <p class="mt-4 text-base leading-relaxed text-muted">{n.resumen}</p>
      <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
        Leer noticia
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </span>
    </div>
  </a>
) : (
  <a href={rutaNoticia(n)} class="card reveal group flex flex-col overflow-hidden" style={`transition-delay:${delay}ms`}>
    <div class="relative aspect-[16/10] overflow-hidden bg-navy-900">
      <img src={withBase(n.imagen)} alt={n.titulo} loading="lazy" decoding="async" width="1200" height="750" class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]" />
    </div>
    <div class="flex flex-1 flex-col p-6">
      <p class="text-xs font-bold uppercase tracking-wider text-muted">{fechaLarga(n.fecha)}</p>
      <h3 class="mt-2 text-lg font-bold leading-snug group-hover:text-brand-600">{n.titulo}</h3>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{n.resumen}</p>
      <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
        Leer noticia
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </span>
    </div>
  </a>
)}
