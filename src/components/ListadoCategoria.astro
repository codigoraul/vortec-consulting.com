---
import Base from '@/layouts/Base.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { getServiciosPorCategoria, getContacto } from '@/lib/wp';
import type { Categoria } from '@/lib/types';

interface Props {
  categoria: Categoria;
  title: string;
  description: string;
  h1: string;
  intro: string;
  imagen: string;
  eyebrow: string;
  subtitulo: string;
  bajada: string;
  ventajas: string[];
}
const { categoria, title, description, h1, intro, imagen, eyebrow, subtitulo, bajada, ventajas } = Astro.props;
const servicios = await getServiciosPorCategoria(categoria);
const contacto = await getContacto();
const nombre = categoria === 'consultoria' ? 'Consultorías' : 'Capacitaciones';
---

<Base title={title} description={description} image={imagen}>
  <section class="relative overflow-hidden bg-navy-950 pt-36 pb-20 text-white">
    <img src={imagen} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-25" width="1920" height="1280" />
    <div class="absolute inset-0 bg-gradient-to-b from-navy-950/70 to-navy-950"></div>
    <div class="container-x relative">
      <nav aria-label="Migas de pan" class="text-sm text-white/60"><a href="/" class="hover:text-white">Inicio</a> <span class="mx-2">/</span> <span class="text-white">{nombre}</span></nav>
      <h1 class="mt-4 h-page">{h1}</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/75">{intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <span class="eyebrow">{eyebrow}</span>
          <h2 class="h-section">{subtitulo}</h2>
          <p class="lead">{bajada}</p>
        </div>
        <p class="shrink-0 text-sm text-muted">{servicios.length} {categoria === 'consultoria' ? 'servicios' : 'cursos'}</p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {servicios.map((s, i) => <ServiceCard servicio={s} delay={(i % 3) * 90} />)}
      </div>
    </div>
  </section>

  <section class="section bg-gray-50">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
      <div class="reveal">
        <span class="eyebrow">Cómo trabajamos</span>
        <h2 class="h-section">{categoria === 'consultoria' ? 'Acompañamiento en terreno, de principio a fin' : 'Cursos pensados para aplicarse al día siguiente'}</h2>
        <ul class="mt-6 space-y-3 text-ink/85">
          {ventajas.map((t) => (
            <li class="flex gap-3"><svg class="mt-1 h-5 w-5 shrink-0 text-brand-500" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span>{t}</span></li>
          ))}
        </ul>
      </div>
      <div class="reveal rounded-3xl bg-navy-900 p-8 text-white md:p-10">
        <h3 class="text-2xl font-bold text-white">¿No encuentra lo que busca?</h3>
        <p class="mt-3 text-white/75">Diseñamos {categoria === 'consultoria' ? 'programas de consultoría' : 'cursos'} a la medida de sus equipos, matrices y procesos. Cuéntenos su necesidad y le enviamos una propuesta.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/contacto" class="btn-primary">Conversemos</a>
          <a href={`mailto:${contacto.email}`} class="btn-ghost-light">{contacto.email}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
