---
import type { Contacto } from '@/lib/types';
import { withBase } from '@/lib/url';

interface Props { contacto: Contacto; overlay?: boolean }
const { contacto, overlay = false } = Astro.props;

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/#nosotros', label: 'Nosotros' },
  { href: '/consultorias', label: 'Consultorías' },
  { href: '/capacitaciones', label: 'Capacitaciones' },
  { href: '/contacto', label: 'Contacto' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href.split('#')[0]) && !href.includes('#'));
---

<header
  id="site-header"
  data-overlay={overlay ? 'true' : 'false'}
  class:list={[
    'fixed inset-x-0 top-0 z-50 transition-all duration-300',
    overlay ? 'text-white' : 'bg-white/90 text-navy-900 shadow-sm backdrop-blur-md',
  ]}
>
  <!-- Barra superior de contacto -->
  <div class:list={['hidden text-xs md:block', overlay ? 'border-b border-white/10' : 'border-b border-line bg-navy-900 text-white/80']} id="topbar">
    <div class="container-x flex h-9 items-center justify-between">
      <div class="flex items-center gap-6">
        <a href={`tel:${contacto.telefono.replace(/\s/g, '')}`} class="inline-flex items-center gap-1.5 hover:text-brand-400">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 00-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
          {contacto.telefono}
        </a>
        <a href={`mailto:${contacto.email}`} class="inline-flex items-center gap-1.5 hover:text-brand-400">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
          {contacto.email}
        </a>
      </div>
      <span class="inline-flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
        {contacto.direccion}, {contacto.comuna}
      </span>
    </div>
  </div>

  <div class="container-x flex h-[72px] items-center justify-between">
    <a href={withBase('/')} class="flex items-center" aria-label="Vortec Consulting — Inicio">
      <img src={withBase('/logo.svg')} alt="Vortec Consulting" width="180" height="56" class="logo-dark h-12 w-auto md:h-14" />
      <img src={withBase('/logo-blanco.svg')} alt="Vortec Consulting" width="180" height="56" class="logo-light h-12 w-auto md:h-14" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      {links.map((l) => (
        <a
          href={withBase(l.href)}
          class:list={[
            'rounded-full px-4 py-2 text-sm font-medium transition-colors hover:text-brand-500',
            isActive(l.href) && 'text-brand-500',
          ]}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >{l.label}</a>
      ))}
      <a href={withBase('/contacto')} class="btn-primary ml-3 !py-2.5 !px-5">Solicitar cotización</a>
    </nav>

    <button id="menu-toggle" class="inline-flex h-11 w-11 items-center justify-center rounded-full lg:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="icon-open h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="icon-close hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden border-t border-line bg-white text-navy-900 lg:hidden">
    <nav class="container-x flex flex-col py-3" aria-label="Móvil">
      {links.map((l) => (
        <a href={withBase(l.href)} class="border-b border-line py-3 text-base font-medium last:border-0">{l.label}</a>
      ))}
      <a href={withBase('/contacto')} class="btn-primary mt-3 mb-2">Solicitar cotización</a>
    </nav>
  </div>
</header>

<style>
  /* Con overlay: logo blanco mientras está transparente; al hacer scroll, logo normal */
  #site-header .logo-light { display: none; }
  #site-header[data-overlay='true']:not(.is-scrolled) .logo-dark { display: none; }
  #site-header[data-overlay='true']:not(.is-scrolled) .logo-light { display: block; }
  #site-header.is-scrolled { background: rgb(255 255 255 / .92); color: var(--color-navy-900); box-shadow: 0 1px 0 var(--color-line); backdrop-filter: blur(12px); }
  #site-header.is-scrolled #topbar { display: none; }
  #site-header.menu-open { background: #fff; color: var(--color-navy-900); }
  #site-header.menu-open .logo-light { display: none !important; }
  #site-header.menu-open .logo-dark { display: block !important; }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    header.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.icon-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')!.classList.toggle('hidden', !open);
  });
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle.click()));
</script>
