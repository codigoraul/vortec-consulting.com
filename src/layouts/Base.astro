---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import { getContacto } from '@/lib/wp';
import { withBase } from '@/lib/url';
import type { SeoYoast } from '@/lib/types';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Header transparente sobre el hero (solo en el home). */
  heroOverlay?: boolean;
  noindex?: boolean;
  /** SEO de Yoast (servicio o noticia) tomado de WordPress; tiene prioridad sobre title/description/image. */
  seo?: SeoYoast;
}

const { title, description, image = '/images/hero-laboratorio.webp', heroOverlay = false, noindex = false, seo } = Astro.props;
const contacto = await getContacto();
const site = Astro.site ?? new URL('https://vortec-consulting.com');
const canonical = seo?.canonical ? new URL(seo.canonical) : new URL(Astro.url.pathname, site);
const ogImage = seo?.ogImage ? new URL(seo.ogImage) : new URL(withBase(image), site);
const metaTitle = seo?.title || title;
const metaDescription = seo?.description || description;
const fullTitle = metaTitle.includes('Vortec') ? metaTitle : `${metaTitle} | Vortec Consulting`;

// Si Yoast SEO está activo en WordPress, usa el grafo de schema.org que genera (Organization,
// WebPage, BreadcrumbList, etc.); si no, un schema básico armado a mano como respaldo.
const orgSchema = seo?.schema ?? {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: contacto.empresa,
  url: site.toString(),
  logo: new URL(withBase('/logo.svg'), site).toString(),
  telephone: contacto.telefono,
  email: contacto.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contacto.direccion,
    addressLocality: contacto.comuna,
    addressRegion: 'Región Metropolitana',
    addressCountry: 'CL',
  },
  areaServed: 'Chile',
  description: metaDescription,
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content="consultoría laboratorios Chile, acreditación ISO 17025, NCh-ISO/IEC 17025, certificación ISO 9001, HACCP, FSSC 22000, inocuidad alimentaria, validación de métodos analíticos, incertidumbre de medición, buenas prácticas de laboratorio, capacitación HPLC, cromatografía gaseosa, ICP-OES ICP-MS, absorción atómica, NIR FTIR, metrología, 5S Lean Manufacturing, optimización de procesos industriales, evaluación de proveedores, control de plagas, RILES, consultoría ambiental, capacitación in-company Santiago" />
    <meta name="geo.region" content="CL-RM" />
    <meta name="geo.placename" content="Santiago, Chile" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="theme-color" content="#0b1f3a" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Vortec Consulting" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header contacto={contacto} overlay={heroOverlay} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer contacto={contacto} />
    <WhatsAppButton contacto={contacto} />

    <script>
      // Animaciones de entrada
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }),
          { threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
