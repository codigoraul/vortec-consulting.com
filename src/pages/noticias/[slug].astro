---
import Base from '@/layouts/Base.astro';
import NoticiaCard from '@/components/NoticiaCard.astro';
import { getNoticias, getContacto, fechaLarga, rutaNoticia } from '@/lib/wp';
import { withBase } from '@/lib/url';

export async function getStaticPaths() {
  const noticias = await getNoticias();
  return noticias.map((n) => ({ params: { slug: n.slug }, props: { noticia: n } }));
}

const { noticia: n } = Astro.props;
const todas = await getNoticias();
const relacionadas = todas.filter((x) => x.slug !== n.slug).slice(0, 3);
const contacto = await getContacto();
const urlCompartir = new URL(rutaNoticia(n), Astro.site ?? 'https://vortec-consulting.com').toString();
---

<Base title={n.titulo} description={n.resumen} image={n.imagen}>
  <section class="relative overflow-hidden bg-navy-950 pt-[110px] pb-9 text-white md:pt-[164px] md:pb-14">
    <img src={withBase(n.imagen)} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-45" width="1920" height="1280" />
    <div class="absolute inset-0 bg-gradient-to-r from-navy-950/95 via-navy-950/75 to-navy-950/40"></div>
    <div class="container-x relative">
      <nav aria-label="Migas de pan" class="hidden text-sm text-white/60 md:block">
        <a href={withBase('/')} class="hover:text-white">Inicio</a> <span class="mx-2">/</span>
        <a href={withBase('/noticias')} class="hover:text-white">Noticias</a>
      </nav>
      <span class="eyebrow mt-4 !text-brand-400">{fechaLarga(n.fecha)}</span>
      <h1 class="h-page mt-3 max-w-3xl">{n.titulo}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_340px]">
      <article class="prose-vortec reveal max-w-3xl text-base" set:html={n.contenido} />

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-3xl bg-navy-950 p-7 text-white">
          <p class="text-sm font-bold uppercase tracking-wider text-brand-400">¿Le interesa este tema?</p>
          <p class="mt-3 text-white/80">Conversemos sobre cómo aplicarlo en su laboratorio o planta.</p>
          <div class="mt-5 flex flex-col gap-3">
            <a href={`https://wa.me/${contacto.whatsapp}`} target="_blank" rel="noopener" class="btn-primary">Escríbenos por WhatsApp</a>
            <a href={withBase('/contacto')} class="btn-ghost-light">Solicitar cotización</a>
          </div>
        </div>
        <div class="card p-6">
          <p class="text-sm font-bold">Compartir</p>
          <div class="mt-3 flex gap-2">
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(urlCompartir)}`} target="_blank" rel="noopener" class="btn-outline !px-4 !py-2 text-xs">LinkedIn</a>
            <a href={`https://wa.me/?text=${encodeURIComponent(n.titulo + ' ' + urlCompartir)}`} target="_blank" rel="noopener" class="btn-outline !px-4 !py-2 text-xs">WhatsApp</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {relacionadas.length > 0 && (
    <section class="section bg-gray-50">
      <div class="container-x">
        <h2 class="reveal text-2xl font-bold">Más noticias</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relacionadas.map((r, i) => <NoticiaCard noticia={r} delay={i * 90} />)}
        </div>
      </div>
    </section>
  )}
</Base>
