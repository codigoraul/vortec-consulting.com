---
import Base from '@/layouts/Base.astro';
import HeroSlider from '@/components/HeroSlider.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { getServiciosPorCategoria, getContacto } from '@/lib/wp';
import { withBase } from '@/lib/url';
import { clientes } from '@/data/clientes';

const consultorias = await getServiciosPorCategoria('consultoria');
const capacitaciones = await getServiciosPorCategoria('capacitacion');
const contacto = await getContacto();

const slides = [
  {
    eyebrow: 'Consultores y capacitación',
    titulo: 'Calidad, procesos y laboratorios',
    destacado: 'a nivel de acreditación',
    texto: 'Consultoría técnica y formación especializada para laboratorios e industria: NCh-ISO/IEC 17025, validación de métodos, BPL, mejora continua y cumplimiento ambiental.',
    imagen: '/images/hero-laboratorio.webp',
    alt: 'Analista realizando ensayos en un laboratorio de control de calidad',
    cta: { href: '/consultorias', label: 'Ver consultorías' },
    cta2: { href: '/contacto', label: 'Solicitar cotización' },
  },
  {
    eyebrow: 'Consultorías',
    titulo: 'Optimizamos sus procesos',
    destacado: 'con resultados medibles',
    texto: '5S y Lean Manufacturing, auditoría a proveedores, optimización de procesos industriales y asesoría en normativa ambiental, directamente en su planta.',
    imagen: '/images/hero-procesos.webp',
    alt: 'Inspector de control de calidad revisando producción en una planta industrial',
    cta: { href: '/consultorias', label: 'Ver consultorías' },
    cta2: { href: '/contacto', label: 'Conversemos' },
  },
  {
    eyebrow: 'Capacitaciones',
    titulo: 'Formación técnica',
    destacado: 'para su equipo',
    texto: 'Cursos in-company de HPLC, GC, ICP, validación e incertidumbre, buenas prácticas de laboratorio y resolución de no conformidades, adaptados a sus equipos y procesos.',
    imagen: '/images/hero-capacitacion.webp',
    alt: 'Relator dictando una capacitación a un equipo de trabajo',
    cta: { href: '/capacitaciones', label: 'Ver capacitaciones' },
    cta2: { href: '/contacto', label: 'Cotizar un curso' },
  },
];

const pilares = [
  { titulo: 'Acreditación y calidad', texto: 'ISO 9001, 14001, 22000, 45001, 50001, ISO/IEC 17025, ASC, RTRS, BAP y GLOBAL G.A.P.: interpretación, implementación y auditoría interna.', icon: 'M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { titulo: 'Instrumentación analítica', texto: 'HPLC, GC-FID/GC-MS, ICP-OES/ICP-MS y NIR: operación, calibración, validación y troubleshooting.', icon: 'M9.75 3v6.9a2.25 2.25 0 01-.66 1.59L4.5 16.08A2.25 2.25 0 006.09 19.5h11.82a2.25 2.25 0 001.59-3.42L14.9 11.5a2.25 2.25 0 01-.65-1.6V3M8.25 3h7.5' },
  { titulo: 'Mejora continua', texto: '5S, Lean Manufacturing, análisis de causa raíz y optimización de procesos con indicadores claros.', icon: 'M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941' },
  { titulo: 'Medio ambiente', texto: 'RILES, residuos peligrosos y normativa ambiental aplicable, con planes de cumplimiento realistas.', icon: 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z' },
];

// Cifras: se calculan desde los datos; ajustar textos si el cliente entrega otras (p. ej. años de experiencia).
const stats = [
  { valor: String(consultorias.length), label: 'áreas de consultoría' },
  { valor: String(capacitaciones.length), label: 'cursos técnicos especializados' },
  { valor: 'In-company', label: 'cursos adaptados a los equipos del cliente' },
  { valor: 'Chile y LATAM', label: 'atención en todo el país y la región' },
];
---

<Base
  title="Vortec Consulting | Consultores y Capacitación para laboratorios e industria"
  description="Consultoría y capacitación técnica en Chile: NCh-ISO/IEC 17025, validación de métodos e incertidumbre, BPL, HPLC, GC, ICP, 5S y Lean Manufacturing, auditoría a proveedores y medio ambiente."
  heroOverlay
>
  <HeroSlider slides={slides} />

  <!-- Pilares -->
  <section class="relative z-10 -mt-14 md:-mt-28">
    <div class="container-x">
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {pilares.map((p, i) => (
          <div class="card reveal p-6" style={`transition-delay:${i * 80}ms`}>
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={p.icon}/></svg>
            </div>
            <h3 class="mt-4 text-lg font-bold">{p.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nosotros -->
  <section id="nosotros" class="section scroll-mt-20">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="reveal relative">
        <div class="absolute -left-6 -top-6 h-40 w-40 rounded-3xl bg-brand-100"></div>
        <img src={withBase('/images/nosotros-equipo.webp')} alt="Consultor de Vortec revisando resultados con un analista de laboratorio" width="1400" height="933" loading="lazy" decoding="async" class="relative rounded-3xl object-cover shadow-card-hover" />
        <div class="absolute -bottom-6 -right-4 hidden rounded-2xl bg-navy-900 p-5 text-white shadow-xl sm:block">
          <p class="text-3xl font-extrabold gradient-text">17025</p>
          <p class="mt-1 text-xs text-white/70">NCh-ISO/IEC · acreditación<br />de laboratorios</p>
        </div>
      </div>
      <div class="reveal">
        <span class="eyebrow">Nosotros</span>
        <h2 class="h-section">Experiencia técnica al servicio de su laboratorio e industria</h2>
        <p class="lead">
          Vortec Consulting es una consultora chilena especializada en calidad, metrología, instrumentación analítica y
          mejora de procesos. Acompañamos a laboratorios, plantas productivas y universidades a cumplir normas,
          acreditarse y trabajar con datos confiables.
        </p>
        <ul class="mt-6 space-y-3 text-ink/85">
          {[
            'Relatores con experiencia real en laboratorios acreditados y plantas industriales.',
            'Cursos in-company adaptados a los equipos, matrices y procesos del cliente.',
            'Entregables concretos: procedimientos, planillas de validación e informes de auditoría.',
          ].map((t) => (
            <li class="flex gap-3"><svg class="mt-1 h-5 w-5 shrink-0 text-brand-500" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span>{t}</span></li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={withBase('/consultorias')} class="btn-primary">Conocer consultorías</a>
          <a href={`https://wa.me/${contacto.whatsapp}`} target="_blank" rel="noopener" class="btn-outline">Escríbenos por WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Cifras -->
  <section class="bg-navy-950 py-14 text-white">
    <div class="container-x grid grid-cols-2 gap-8 md:grid-cols-4">
      {stats.map((s, i) => (
        <div class="reveal text-center" style={`transition-delay:${i * 80}ms`}>
          <p class="text-3xl font-extrabold gradient-text sm:text-4xl md:text-5xl">{s.valor}</p>
          <p class="mt-2 text-sm text-white/65">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Consultorías -->
  <section id="consultorias" class="section scroll-mt-20 bg-gray-50">
    <div class="container-x">
      <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <span class="eyebrow">Consultorías</span>
          <h2 class="h-section">Soluciones a medida para su operación</h2>
          <p class="lead">Diagnóstico, implementación y seguimiento en terreno junto a su equipo.</p>
        </div>
        <a href={withBase('/consultorias')} class="btn-outline shrink-0">Ver todas las consultorías</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {consultorias.slice(0, 3).map((s, i) => <ServiceCard servicio={s} delay={i * 90} />)}
      </div>
    </div>
  </section>

  <!-- Capacitaciones -->
  <section id="capacitaciones" class="section scroll-mt-20">
    <div class="container-x">
      <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <span class="eyebrow">Capacitaciones</span>
          <h2 class="h-section">Cursos técnicos para analistas y encargados de calidad</h2>
          <p class="lead">Programas teórico-prácticos, in-company o en modalidad remota, con temario adaptable.</p>
        </div>
        <a href={withBase('/capacitaciones')} class="btn-outline shrink-0">Ver todas las capacitaciones</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {capacitaciones.slice(0, 6).map((s, i) => <ServiceCard servicio={s} delay={i * 90} />)}
      </div>
    </div>
  </section>

  <!-- Clientes -->
  <section class="section bg-gray-50">
    <div class="container-x">
      <div class="reveal mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center">Clientes</span>
        <h2 class="h-section">Empresas e instituciones que han confiado en nosotros</h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {clientes.map((c, i) => (
          <div class="card reveal flex items-start gap-4 p-5" style={`transition-delay:${i * 60}ms`}>
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-navy-900 text-sm font-extrabold text-brand-400">{c.nombre.slice(0, 2).toUpperCase()}</div>
            <div>
              <p class="font-bold">{c.nombre}</p>
              <p class="mt-1 text-sm text-muted">{c.servicio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container-x">
      <div class="reveal relative overflow-hidden rounded-3xl bg-navy-900 px-8 py-14 text-white md:px-16">
        <div class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-brand-500/30 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-24 left-1/3 h-72 w-72 rounded-full bg-brand-700/40 blur-3xl"></div>
        <div class="relative grid items-center gap-8 md:grid-cols-[1fr_auto]">
          <div>
            <h2 class="text-3xl font-bold text-white md:text-4xl">¿Necesita una consultoría o capacitación?</h2>
            <p class="mt-3 max-w-xl text-white/75">Cuéntenos su necesidad y le enviaremos una propuesta técnica y económica a medida.</p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={withBase('/contacto')} class="btn-primary">Solicitar cotización</a>
            <a href={`https://wa.me/${contacto.whatsapp}`} target="_blank" rel="noopener" class="btn-ghost-light">WhatsApp</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
