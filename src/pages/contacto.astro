---
import Base from '@/layouts/Base.astro';
import ContactForm from '@/components/ContactForm.astro';
import { getContacto } from '@/lib/wp';
import { withBase } from '@/lib/url';
const c = await getContacto();
---

<Base
  title="Contacto y cotizaciones"
  description={`Solicite una cotización de consultoría o capacitación. WhatsApp ${c.telefono}, ${c.email}. ${c.direccion}, ${c.comuna}, Santiago.`}
>
  <section class="relative overflow-hidden bg-navy-950 pt-[110px] pb-9 text-white md:pt-[164px] md:pb-14">
    <img src={withBase('/images/nosotros.webp')} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-55" width="1920" height="1281" />
    <div class="absolute inset-0 bg-gradient-to-b from-navy-950/45 via-navy-950/60 to-navy-950/85"></div>
    <div class="container-x relative">
      <nav aria-label="Migas de pan" class="hidden text-sm text-white/60 md:block"><a href={withBase('/')} class="hover:text-white">Inicio</a> <span class="mx-2">/</span> <span class="text-white">Contacto</span></nav>
      <h1 class="h-page mt-3">Contáctenos</h1>
      <p class="mt-3 hidden max-w-2xl text-[17px] leading-relaxed text-white/75 md:block">Cuéntenos qué necesita y le responderemos con una propuesta a la medida.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[400px_1fr]">
      <aside class="space-y-4 lg:pt-[159px]">
        {[
          { t: 'WhatsApp / Teléfono', v: c.telefono, href: `https://wa.me/${c.whatsapp}`, icon: 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 00-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z' },
          { t: 'Correo electrónico', v: c.email, href: `mailto:${c.email}`, icon: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75' },
          { t: 'Dirección', v: `${c.direccion}, ${c.comuna}, ${c.ciudad}`, href: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(c.direccion + ', ' + c.comuna + ', Chile')}`, icon: 'M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm4.5 0c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z' },
          { t: 'Horario', v: c.horario, icon: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z' },
        ].map((i) => (
          <div class="card reveal flex gap-4 p-5">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d={i.icon}/></svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-muted">{i.t}</p>
              {i.href ? <a href={i.href} target={i.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="mt-1 block font-semibold hover:text-brand-600">{i.v}</a> : <p class="mt-1 font-semibold">{i.v}</p>}
            </div>
          </div>
        ))}
      </aside>

      <div class="reveal">
        <span class="eyebrow">Formulario</span>
        <h2 class="h-section">Solicite una cotización</h2>
        <p class="lead">Complete el formulario y nos pondremos en contacto a la brevedad.</p>
        <div class="mt-8">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  {c.mapaEmbed && (
    <section class="pb-0">
      <iframe
        src={c.mapaEmbed}
        title={`Mapa: ${c.direccion}, ${c.comuna}`}
        class="h-[420px] w-full border-0 grayscale-[30%]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </section>
  )}
</Base>
