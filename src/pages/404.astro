---
import Base from '@/layouts/Base.astro';
---
<Base title="Página no encontrada" description="La página que busca no existe." noindex>
  <section class="section pt-40">
    <div class="container-x max-w-2xl text-center">
      <p class="text-7xl font-extrabold gradient-text">404</p>
      <h1 class="mt-4 text-3xl font-extrabold">Página no encontrada</h1>
      <p class="lead">La dirección que ingresó no existe o fue movida.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">Ir al inicio</a>
        <a href="/consultorias" class="btn-outline">Ver consultorías</a>
      </div>
    </div>
  </section>
</Base>
